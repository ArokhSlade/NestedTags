[configuration]

entry_symbol = "nested_tags_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "./bin/libnested_tags.macos.template_debug.dylib"
macos.release = "./bin/libnested_tags.macos.template_release.dylib"
windows.debug.x86_32 = "./bin/nested_tags.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "./bin/nested_tags.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "./bin/nested_tags.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/nested_tags.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./bin/libnested_tags.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/libnested_tags.linux.template_release.x86_64.so"
linux.debug.arm64 = "./bin/libnested_tags.linux.template_debug.arm64.so"
linux.release.arm64 = "./bin/libnested_tags.linux.template_release.arm64.so"
linux.debug.rv64 = "./bin/libnested_tags.linux.template_debug.rv64.so"
linux.release.rv64 = "./bin/libnested_tags.linux.template_release.rv64.so"